# focusBoard — copia este archivo a .env.local y pega tus valores.
# Los mismos nombres van en Vercel → Project → Settings → Environment Variables.
# Nunca commitees .env.local (ya está en .gitignore).

# Neon Postgres (Console → el proyecto → Connection string; usa la del pooler)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Cloudflare R2 (Dashboard → R2 → overview, y → API Tokens para las claves)
R2_ACCOUNT_ID=ACCOUNT_ID_HEX_32
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=focusboard

# Passcode: el PIN con el que entras a la app (mínimo 4 caracteres)
PASSCODE=

# Secreto para firmar la cookie de sesión (32+ bytes aleatorios, hex)
SESSION_SECRET=

# (Opcional) sal para hashear ip/dispositivo/user-agent en login_attempts.
# Si falta, se usa SESSION_SECRET. Cambiarla invalida los contadores.
LOGIN_LOCK_SALT=
